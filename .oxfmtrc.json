{
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "es5",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "**/dist/**",
    "/dev",
    "src-legacy",
    "package.zip",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "theme.json",
    "theme.css"
  ]
}
