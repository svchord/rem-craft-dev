{
  "name": "rem-craft-theme",
  "private": true,
  "type": "module",
  "version": "3.1.0",
  "description": "Rem Craft theme for SiYuan Note",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run type-check && vite build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts uno.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "measure": "syt measure",
    "shot": "syt shot"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "semantic-release": "^25.0.9",
    "siyuan-devkit": "link:../siyuan-devkit",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
