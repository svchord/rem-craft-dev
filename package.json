{
  "name": "rem-craft-theme",
  "private": true,
  "type": "module",
  "version": "3.0.1",
  "description": "Rem Craft theme for SiYuan Note",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node ./scripts/dev-live.mjs",
    "build": "pnpm run clean && pnpm run check:manifest && pnpm run type-check && vite build && pnpm run check:dist",
    "check": "pnpm run check:manifest && pnpm run format:check && pnpm run type-check && pnpm run test",
    "check:manifest": "node ./scripts/check_manifest.mjs",
    "check:dist": "node ./scripts/check_dist.mjs",
    "clean": "node ./scripts/clean.js",
    "type-check": "tsc --build --force",
    "test": "vitest run",
    "lint": "oxlint src scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "audit:theme": "node ./scripts/cdp/audit.mjs",
    "inspect": "node ./scripts/cdp/inspect.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "fast-glob": "^3.3.3",
    "minimist": "^1.2.8",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "puppeteer-core": "^25.16.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.5"
  }
}
