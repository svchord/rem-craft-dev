{
  "name": "rem-craft-theme",
  "private": true,
  "type": "module",
  "version": "3.1.0",
  "description": "Rem Craft theme for SiYuan Note",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run clean && pnpm run type-check && vite build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "clean": "node ./scripts/clean.js",
    "type-check": "tsc --build --force && pnpm --filter siyuan-devkit type-check",
    "test": "vitest run && pnpm --filter siyuan-devkit test",
    "lint": "oxlint --deny-warnings src scripts packages",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "make-link": "syt link",
    "link:check": "syt link --check",
    "measure": "syt measure",
    "watch:theme": "syt watch --dir src/styles",
    "open:theme": "syt open"
  },
  "devDependencies": {
    "siyuan-devkit": "workspace:*",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "minimist": "^1.2.8",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "puppeteer-core": "^25.16.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.5"
  }
}
