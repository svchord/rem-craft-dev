{
  "tabs": [
    {
      "id": "style",
      "title": "$tab.style",
      "icon": "iconTheme",
      "groups": [
        {
          "id": "appearance",
          "title": "$group.appearance",
          "items": [
            {
              "id": "style",
              "type": "select",
              "title": "$style.title",
              "description": "$style.description",
              "default": "m3",
              "options": [
                {
                  "value": "m3",
                  "label": "Material 3"
                }
              ],
              "apply": {
                "kind": "attribute",
                "name": "data-rc-style"
              }
            },
            {
              "id": "field",
              "type": "select",
              "title": "$fieldStyle.title",
              "description": "$fieldStyle.description",
              "default": "filled",
              "options": [
                {
                  "value": "filled",
                  "label": "$fieldStyle.filled"
                },
                {
                  "value": "outlined",
                  "label": "$fieldStyle.outlined"
                }
              ],
              "showWhen": {
                "style": "m3"
              },
              "apply": {
                "kind": "attribute",
                "name": "data-rc-field"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "feature",
      "title": "$tab.feature",
      "icon": "iconSparkles",
      "groups": [
        {
          "id": "color",
          "title": "$group.color",
          "items": [
            {
              "id": "seed",
              "type": "color",
              "title": "$seed.title",
              "description": "$seed.description",
              "default": "#1a73e8",
              "showWhen": {
                "style": "m3"
              },
              "apply": {
                "kind": "palette",
                "generator": "m3"
              }
            }
          ]
        }
      ]
    }
  ]
}
