{
  "viewport": "1600x1000@1",
  "cases": [
    {
      "name": "arco-calendar：弹层与停靠栏样式生效",
      "probes": [
        {
          "label": "calendar-popup",
          "html": "<div class=\"sy-calendar-popup\"></div>",
          "target": ".sy-calendar-popup",
          "expect": {
            "position": "fixed",
            "z-index": "99999",
            "border-radius": "10px",
            "padding-top": "16px"
          }
        },
        {
          "label": "calendar-dock",
          "html": "<div class=\"sy-calendar-dock\"></div>",
          "target": ".sy-calendar-dock",
          "expect": {
            "padding-top": "12px",
            "background-color": "rgb(255, 255, 255)"
          }
        }
      ]
    }
  ]
}
