{
  "name": "rem-craft-theme",
  "private": true,
  "type": "module",
  "version": "3.1.0",
  "description": "Rem Craft theme for SiYuan Note",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run type-check && vite build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src tests vite.config.ts vitest.config.ts uno.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "open": "siyuan-devtools open --frontend desktop",
    "shot": "siyuan-devtools shot",
    "prepare": "husky",
    "commitlint": "commitlint --from origin/main --to HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "siyuan-devtools": "^0.1.0",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vite-plugin-siyuan": "^0.1.0",
    "vitest": "^5.0.5"
  }
}
