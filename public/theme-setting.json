{
  "features": {
    "ripple": {
      "tab": "general",
      "group": "ripple",
      "selector": ".dock__item, .b3-menu__item, .b3-button:not(:disabled)",
      "className": "rc-ripple",
      "duration": 450
    }
  },
  "tabs": [
    {
      "id": "general",
      "title": "$tab.general",
      "icon": "iconTheme",
      "groups": [
        {
          "id": "appearance",
          "title": "$group.appearance",
          "items": [
            {
              "id": "style",
              "type": "select",
              "title": "$style.title",
              "description": "$style.description",
              "default": "m3",
              "options": [
                {
                  "value": "m3",
                  "label": "Material 3"
                }
              ],
              "apply": {
                "kind": "attribute",
                "name": "data-rc-style"
              }
            }
          ]
        },
        {
          "id": "color",
          "title": "$group.color",
          "items": [
            {
              "id": "seed",
              "type": "color",
              "title": "$seed.title",
              "description": "$seed.description",
              "default": "#1a73e8",
              "showWhen": {
                "style": "m3"
              },
              "apply": {
                "kind": "palette",
                "generator": "m3"
              }
            }
          ]
        }
      ]
    }
  ]
}
